<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Grafik.Controls"
             x:Class="Grafik.MainPage"
             Title="График"
             BackgroundColor="#1E1E1E">

    <AbsoluteLayout>
        <Grid RowDefinitions="Auto,*"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">

            <!-- Верхняя панель с индикатором -->
            <Grid Grid.Row="0" 
                  Padding="15,10" 
                  BackgroundColor="#2D2D2D"
                  ColumnDefinitions="*,Auto">

                <Label Grid.Column="0"
                       Text="📅 Расписание"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"/>

                <!-- Индикатор соединения -->
                <controls:ConnectionIndicator Grid.Column="1"/>
            </Grid>

            <!-- Основной контент -->
            <ScrollView Grid.Row="1">
                <StackLayout Padding="20,20,20,90" Spacing="15" x:Name="MainStackLayout">
                    <!-- Первая группа элементов (начальное состояние) -->
                    <StackLayout x:Name="FirstStepGroup">
                        <Label Text="Загрузи Excel файл расписания" 
                               FontSize="22" 
                               HorizontalOptions="Center" />

                        <Label x:Name="Transp1" 
                               BackgroundColor="Transparent"/>

                        <Button Text="Загрузить EXCEL" 
                                Clicked="OnLoadExcelClicked"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="#191968"
                                TextColor="White"/>
                    </StackLayout>

                    <!-- Вторая группа элементов (изначально скрыта) -->
                    <StackLayout x:Name="SecondStepGroup" IsVisible="False">
                        <Label x:Name="Instruction2" 
                               Text="Выбери сотрудника" 
                               FontSize="22" 
                               HorizontalOptions="Center"/>

                        <Label x:Name="Transp2" 
                               BackgroundColor="Transparent"/>

                        <Picker x:Name="EmployeePicker" 
                                SelectedIndexChanged="OnEmployeeSelected"
                                HorizontalOptions="FillAndExpand"/>

                        <Label x:Name="Transp3" BackgroundColor="Transparent"/>

                        <Button x:Name="LoadSchedule" 
                                Text="Показать расписание" 
                                Clicked="LoadScheduleForEmployeer"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="#191968"
                                TextColor="White"/>
                    </StackLayout>

                    <!-- Сводка (видна, когда выбран сотрудник и есть расписание) -->
                    <StackLayout x:Name="DashboardGroup" IsVisible="False" Spacing="12">

                        <Frame Padding="12" CornerRadius="12" HasShadow="False"
                               BackgroundColor="#2D2D2D" BorderColor="#3D3D3D">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="HomeNextTitleLabel" FontSize="12" TextColor="#B0B0B0" />
                                <Label x:Name="HomeNextTextLabel" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                <Label x:Name="HomeNextCountdownLabel" FontSize="13" TextColor="#4CAF50" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame x:Name="HomeTodayCard" IsVisible="False" Padding="12" CornerRadius="12"
                               HasShadow="False" BackgroundColor="#2D2D2D" BorderColor="#3D3D3D">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Сегодня на смене" FontSize="12" TextColor="#B0B0B0" />
                                <Label x:Name="HomeTodayLabel" FontSize="14" TextColor="White" />
                            </VerticalStackLayout>
                        </Frame>

                        <Label Text="Расписания" FontSize="12" TextColor="#B0B0B0" />
                        <Grid x:Name="SlotTilesGrid" ColumnSpacing="8" />

                        <Frame x:Name="ChatTile" Padding="12" CornerRadius="12" HasShadow="False"
                               BackgroundColor="#2D2D2D" BorderColor="#3D3D3D">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChatTileTapped" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label x:Name="ChatStatusDot" Text="●" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label x:Name="ChatStatusLabel" FontSize="14" TextColor="White" />
                                    <Label x:Name="ChatUnreadLabel" FontSize="12" TextColor="#B0B0B0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <Label x:Name="MessageLabel" 
                           IsVisible="False"
                           HorizontalOptions="Center"
                           TextColor="Red"/>
                </StackLayout>
            </ScrollView>
        </Grid>

        <!-- Кнопка удаления (слева снизу) -->
        <Button x:Name="DeleteData"
                Text="🗑"
                FontSize="16"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="DarkRed"
                TextColor="White"
                Clicked="DeleteAllFiles"
                AbsoluteLayout.LayoutBounds="10,1,50,50"
                AbsoluteLayout.LayoutFlags="YProportional" />

        <!-- Кнопка чата (центр снизу) -->
        <Button x:Name="ChatButton"
                Text="💬"
                FontSize="16"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#4CAF50"
                TextColor="White"
                Clicked="GoToChat"
                IsVisible="False"   
                AbsoluteLayout.LayoutBounds="0.5,1,50,50"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional"/>

        <!-- Кнопка настроек (справа снизу) -->
        <Button x:Name="SettingsButton"
                Text="⚙"
                FontSize="16"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#007ACC"
                TextColor="White"
                Clicked="GoToSettings"
                AbsoluteLayout.LayoutBounds="1,1,60,50"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional" />

        <!-- Скрытые кнопки для тестирования -->
        <Button Text="Тест мгновенного уведомления" 
                Clicked="OnTestImmediateNotificationClicked"
                IsEnabled="False" 
                IsVisible="False"/>

        <Button Text="Тест планирования уведомления" 
                Clicked="OnTestScheduledNotificationClicked"
                IsEnabled="False" 
                IsVisible="False"/>
    </AbsoluteLayout>
</ContentPage>